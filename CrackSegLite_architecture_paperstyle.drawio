Style=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c54" target="c55"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c55" target="c56"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c56" target="c57"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c57" target="c58"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c65" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c58" target="c59"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c66" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontStyle=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="c55" target="c59"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="418" y="486"/><mxPoint x="856" y="486"/></Array></mxGeometry></mxCell><mxCell id="c67" value="identity x" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=9;" vertex="1" parent="1"><mxGeometry x="428" y="466" width="200" height="18" as="geometry"/></mxCell><mxCell id="c68" value="" style="rounded=0;html=1;endArrow=classic;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontStyle=1;dashed=1;exitX=0.1;exitY=1;entryX=0.05;entryY=0;" edge="1" parent="1" source="c7" target="c53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c69" value="" style="rounded=0;html=1;endArrow=classic;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontStyle=1;dashed=1;exitX=0.9;exitY=1;entryX=0.95;entryY=0;" edge="1" parent="1" source="c7" target="c53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c70" value="&lt;b&gt;Fig. 1.&lt;/b&gt; CrackSegLite architecture. The input image is pre-processed (CLAHE) and passed through the Adaptive Gradient Stem (AGS) and a five-stage Geometric Enhancement Encoder of GEB blocks (DFM → AGG → SGRM → Coordinate Attention → Residual Connection), followed by the Context Pyramid Module (CPM) bottleneck (1×1 convolution, dilation rates 6 and 12, and global average pooling) and the three-stage Multi-Scale Bidirectional Decoder (MSBD). Each decoder stage applies CARAFE upsampling, concatenates the encoder skip features (f0, f1, f2) and refines them with ConvBNAct and DFM; the 1×1 segmentation head and bilinear upsampling produce the 256×256 binary crack mask." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="0" y="730" width="1850" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>