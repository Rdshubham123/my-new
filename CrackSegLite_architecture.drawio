dgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#000000;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="c13" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="&lt;b&gt;Feature concatenation → 1×1 Conv fusion&lt;/b&gt;&lt;br&gt;F_CPM = Conv([b1×1 ; b6 ; b12 ; b_GAP])" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffff99;strokeColor=#b8a800;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1420" y="410" width="270" height="62" as="geometry"/></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#000000;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="c21" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#000000;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="c23" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#000000;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="c25" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#000000;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="c27" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="&lt;b&gt;Decoder Stage 3&lt;/b&gt;&lt;br&gt;CARAFE ×2 (32→64)&lt;br&gt;→ concat f0&lt;br&gt;→ ConvBNAct → DFM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="870" y="395" width="150" height="110" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Decoder Stage 2&lt;/b&gt;&lt;br&gt;CARAFE ×2 (64→128)&lt;br&gt;→ concat f1&lt;br&gt;→ ConvBNAct → DFM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="530" y="395" width="150" height="110" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Decoder Stage 1&lt;/b&gt;&lt;br&gt;CARAFE ×2 (128→256)&lt;br&gt;→ concat f2&lt;br&gt;→ ConvBNAct → DFM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="360" y="395" width="150" height="110" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Segmentation head&lt;/b&gt;&lt;br&gt;1×1 Conv (1 ch)&lt;br&gt;+ bilinear upsample" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="190" y="395" width="150" height="110" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Binary crack mask&lt;/b&gt;&lt;br&gt;256×256&lt;br&gt;(threshold 0.6; 0.5 with TTA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;fontSize=10;arcSize=8;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="395" width="150" height="110" as="geometry"/></mxCell><mxCell id="c39" value="F_CPM" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#000000;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="c29" target="c34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#000000;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="c34" target="c35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#000000;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="c35" target="c36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c42" value="" style="ed