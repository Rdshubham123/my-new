<mxfile host="app.diagrams.net"><diagram id="cracksegliteArch" name="CrackSegLite Architecture"><mxGraphModel dx="1800" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="CrackSegLite – Geometry-Aware Lightweight Network for Road Pavement Crack Segmentation (corrected to match the paper)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="900" height="28" as="geometry"/></mxCell><mxCell id="c3" value="Geometric Enhancement Encoder – 5 × GEB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;arcSize=8;dashed=0;arcSize=4;fontStyle=1;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="518" y="48" width="854" height="190" as="geometry"/></mxCell><mxCell id="c4" value="Context Pyramid Module (CPM) – bottleneck" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=8;dashed=0;arcSize=4;fontStyle=1;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1400" y="48" width="310" height="470" as="geometry"/></mxCell><mxCell id="c5" value="Multi-Scale Bidirectional Decoder (MSBD) – 3 stages, CPM context propagated to every decoder level" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=8;dashed=0;arcSize=4;fontStyle=1;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="345" y="352" width="690" height="175" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Input image&lt;/b&gt;&lt;br&gt;road pavement RGB&lt;br&gt;resized to 256×256" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="150" height="130" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Pre-processing&lt;/b&gt;&lt;br&gt;CLAHE on LAB luminance&lt;br&gt;(clip 2.5, tile 8×8)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="190" y="90" width="150" height="130" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Adaptive Gradient Stem (AGS)&lt;/b&gt;&lt;br&gt;4 branches: 3×3 DW,&lt;br&gt;5×5 DW, Sobel |∇|,&lt;br&gt;local contrast&lt;br&gt;→ concat → 1×1 proj&lt;br&gt;48 ch · 256×256" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="360" y="90" width="150" height="130" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;GEB Stage 1&lt;/b&gt;&lt;br&gt;stride 2&lt;br&gt;64 ch · 128×128" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="530" y="90" width="150" height="130" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;GEB Stage 2-1&lt;/b&gt;&lt;br&gt;stride 2&lt;br&gt;96 ch · 64×64" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="700" y="90" width="150" height="130" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;GEB Stage 2-2&lt;/b&gt;&lt;br&gt;stride 1 + residual&lt;br&gt;96 ch · 64×64" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="870" y="90" width="150" height="130" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;GEB Stage 3-1&lt;/b&gt;&lt;br&gt;stride 2&lt;br&gt;144 ch · 32×32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1040" y="90" width="150" height="130" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;GEB Stage 3-2&lt;/b&gt;&lt;br&gt;stride 1 + residual&lt;b