s"><mxPoint x="1555" y="575"/><mxPoint x="435" y="575"/></Array></mxGeometry></mxCell><mxCell id="c49" value="&lt;b&gt;Deep supervision&lt;/b&gt;: auxiliary prediction at each decoder stage (weight 0.4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="500" y="590" width="430" height="44" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;Loss&lt;/b&gt; = L_Focal (α=0.75, γ=2) + L_Dice (smooth=1) + 0.4 × L_DS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="980" y="590" width="380" height="44" as="geometry"/></mxCell><mxCell id="c51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#000000;strokeWidth=1;fontSize=10;" edge="1" parent="1" source="c49" target="c50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c52" value="GEB internals (every encoder stage): 1×1 channel expansion → four geometry operations → residual if stride = 1 and channels preserved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#9673a6;fontSize=12;arcSize=8;dashed=0;arcSize=4;fontStyle=1;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="660" width="1060" height="150" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b&gt;1×1 Conv&lt;/b&gt;&lt;br&gt;channel expansion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;arcSize=8;" vertex="1" parent="1"><mxGeometry x="36" y="700" width="160" height="100" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;DFM&lt;/b&gt; Directional Feature Mixture&lt;br&gt;5 directional DW kernels (1×5, 5×1, 3×7, 7×3, diagonal), per-direction learned attention" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9;arcSize=8;" vertex="1" parent="1"><mxGeometry x="208" y="700" width="160" height="100" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b&gt;AGG&lt;/b&gt; Adaptive Geometric Gate&lt;br&gt;H/V edge conv → sigmoid gate on DFM features" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffff99;strokeColor=#b8a800;fontSize=9;arcSize=8;" vertex="1" parent="1"><mxGeometry x="380" y="700" width="160" height="100" as="geometry"/></mxCell><mxCell id="c56" value="&lt;b&gt;SGRM&lt;/b&gt; Selective Geometry Refinement&lt;br&gt;channel importance score blends DFM refinement path with input" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;arcSize=8;" vertex="1" parent="1"><mxGeometry x="552" y="700" width="160" height="100" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b&gt;Coordinate Attention&lt;/b&gt;&lt;br&gt;horizontal + vertical position-aware channel attention" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;arcSize=8;" vertex="1" parent="1"><mxGeometry x="724" y="700" width="160" height="100" as="geometry"/></mxCell><mxCell id="c58" value="&lt;b&gt;⊕ Residual&lt;/b&gt;&lt;br&gt;y = GEB(x) + x&lt;br&gt;(stride 1, same channels)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;arcSize=8;" vertex="1" parent="1"><mxGeometry x="896" y="700" width="160" height="100" as="geometry"/></mxCell><mxCell id="c59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#000000;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="c53" target="c54"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#000000;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="c54" target="c55"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#000000;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="c55" target="c56"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#000000;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="c56" target="c57"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#000000;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="c57" target="c58"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c64" value="identity skip" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#b85450;strokeWidth=2;fontSize=10;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="c53" target="c58"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="116" y="684"/><mxPoint x="976" y="684"/></Array></mxGeometry></mxCell><mxCell id="c65" value="&lt;b&gt;Model statistics&lt;/b&gt;&lt;br&gt;0.89 M params · ≈1.2 GFLOPs · 3.38 MB&lt;br&gt;PyTorch, trained from scratch (no pretrained weights)&lt;br&gt;Optimizer AdamW, lr 1e-4, 150 epochs, batch 8&lt;br&gt;Test-time augmentation: orig + H-flip + V-flip + 180° rotation" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1100" y="660" width="300" height="150" as="geometry"/></mxCell><mxCell id="c66" value="Solid black: forward path · Pink dashed: encoder→decoder skip (f0,f1,f2) · Green dashed: CPM context to all decoder levels" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1400" y="530" width="310" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>